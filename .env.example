# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
MOCK_PROVIDERS=False
# Leave unset to mirror MOCK_PROVIDERS. Set False to use mock flight data with real messaging.
# MOCK_MESSAGING=False
DEMO_MODE=False

# ---- Database (Supabase Postgres) ----
# Use the connection string from Supabase > Project Settings > Database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# ---- Flight data: FlightAware AeroAPI ----
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi
# Shared secret used to verify inbound AeroAPI alert webhooks
FLIGHTAWARE_WEBHOOK_SECRET=
# Publicly reachable base URL AeroAPI will POST alerts to (use ngrok in dev)
PUBLIC_WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok.io

# ---- Messaging: Twilio (WhatsApp + SMS) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1XXXXXXXXXX

# ---- Email (SendGrid OR SMTP) ----
SENDGRID_API_KEY=
EMAIL_FROM=alerts@example.com

# ---- Brain configuration (NEVER hardcode these in code) ----
DELAY_T1_MIN=30
DELAY_T2_MIN=60
DELAY_T3_MIN=120
RECOVERY_BUFFER_MIN=15
BACKSTOP_HOURS=24
